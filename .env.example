# Secret Network pulsar-3 testnet endpoints.
# Override these if the default public nodes are rate limited or down.

# LCD / REST endpoint used for all queries and tx broadcasting.
NEXT_PUBLIC_SECRET_LCD_URL=https://api.pulsar3.scrtlabs.com/api

# Known working alternates:
#   https://api.pulsar3.scrtlabs.com/api
#   https://lcd.testnet.secretsaturn.net
#   https://pulsar.lcd.secretnodes.com

# RPC endpoint - only handed to Keplr in the chain suggestion payload.
NEXT_PUBLIC_SECRET_RPC_URL=https://rpc.pulsar3.scrtlabs.com/rpc

# Block explorer template for tx links. {hash} is replaced with the tx hash.
NEXT_PUBLIC_EXPLORER_TX_URL=https://testnet.ping.pub/secret/tx/{hash}
