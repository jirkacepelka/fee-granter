# Endpoints. All accept a COMMA-SEPARATED LIST: the app probes each entry in
# order and uses the first that answers with JSON and reports the right chain
# id, so a dead public node fails over instead of breaking the page.
#
# These are only the compiled-in defaults. Endpoints can also be overridden per
# chain at runtime from Settings in the app, which takes precedence.

# --- pulsar-3 testnet ---
NEXT_PUBLIC_SECRET_LCD_URL=https://pulsar.lcd.secretnodes.com,https://api.pulsar3.scrtlabs.com/api,https://lcd.testnet.secretsaturn.net
NEXT_PUBLIC_SECRET_RPC_URL=https://pulsar.rpc.secretnodes.com,https://rpc.pulsar3.scrtlabs.com/rpc
NEXT_PUBLIC_EXPLORER_TX_URL=https://testnet.ping.pub/secret/tx/{hash}

# --- secret-4 mainnet ---
NEXT_PUBLIC_SECRET_MAINNET_LCD_URL=https://lcd-secret.keplr.app,https://lcd.mainnet.secretsaturn.net,https://lcd.secret.express
NEXT_PUBLIC_SECRET_MAINNET_RPC_URL=https://rpc-secret.keplr.app,https://rpc.mainnet.secretsaturn.net,https://rpc.secret.express
NEXT_PUBLIC_MAINNET_EXPLORER_TX_URL=https://www.mintscan.io/secret/tx/{hash}

# --- Prices ---
# Osmosis SQS is tried first. See https://docs.osmosis.zone/integrate/prices/
# If it is unreachable from the browser (it does not always send CORS headers),
# the app falls back to CoinGecko automatically.
# Only queried on mainnet; testnet SCRT has no market and shows "No price".
NEXT_PUBLIC_PRICE_API_URL=https://sqsprod.osmosis.zone/tokens/prices

# --- Gas vault contract (contracts/gas-vault), optional ---
# Address of a deployed vault. The dashboard offers "Buy gas credit" whenever one
# is set, having the contract issue the allowance instead of your own wallet.
# Settings overrides this per chain at runtime.
# pulsar-3 defaults to this repo's own deployment,
# secret1g6aw3d26kkd88yduqxaf7axffj3xfjvuklh4jf; set this to point at your own.
# Leaving either blank keeps the built-in default.
NEXT_PUBLIC_GAS_VAULT_ADDRESS=
# No vault is deployed on mainnet, so this one starts out with nothing.
NEXT_PUBLIC_GAS_VAULT_ADDRESS_MAINNET=
