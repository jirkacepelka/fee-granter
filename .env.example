# Secret Network pulsar-3 testnet endpoints.
#
# Both settings accept a COMMA-SEPARATED LIST. The app probes each entry in
# order and uses the first one that answers with JSON and reports pulsar-3, so
# a dead public node fails over instead of breaking the page. Set a single URL
# to pin one node.
#
# Leave these unset to use the built-in defaults below.

# LCD / REST endpoint used for all queries and tx broadcasting.
NEXT_PUBLIC_SECRET_LCD_URL=https://api.pulsar3.scrtlabs.com/api,https://pulsar.lcd.secretnodes.com,https://lcd.testnet.secretsaturn.net,https://api.pulsar.scrttestnet.com

# RPC endpoint - only handed to Keplr in the chain suggestion payload.
# Keplr checks this itself, so a dead RPC fails at connect time.
NEXT_PUBLIC_SECRET_RPC_URL=https://rpc.pulsar3.scrtlabs.com/rpc,https://pulsar.rpc.secretnodes.com,https://rpc.testnet.secretsaturn.net

# Block explorer template for tx links. {hash} is replaced with the tx hash.
NEXT_PUBLIC_EXPLORER_TX_URL=https://testnet.ping.pub/secret/tx/{hash}
